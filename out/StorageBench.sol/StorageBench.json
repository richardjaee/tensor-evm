,\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Storage slots and contract code hold the same bytes and are charged on completely      different schedules, and the gap decides whether a token costs 350M gas or 90M. The      comparison is measured here rather than derived from the yellow paper, because the      derivation has been wrong in the optimistic direction twice already.\",\"kind\":\"dev\",\"methods\":{\"roundTrip(bytes)\":{\"details\":\"The round trip, not the two halves. A prologue whose `CODECOPY` offset      disagrees with its own length deploys code shifted by a few bytes, which no      write-only check can see \\u2014 and in a key/value cache the first read happens one      position after the first write, so it stays hidden for a whole forward pass.\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"benchCode(bytes)\":{\"notice\":\"Write `data` as contract code and report the gas\"},\"benchCodeRead(uint256)\":{\"notice\":\"Read it back and report the gas\"},\"benchStorage(bytes)\":{\"notice\":\"Write `data` to storage slots and report the gas\"},\"benchStorageRead(uint256)\":{\"notice\":\"Read it back and report the gas\"},\"roundTrip(bytes)\":{\"notice\":\"Write then read, returning what came back\"}},\"notice\":\"Prices the two ways of keeping a key/value cache on chain, side by side.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/src/StorageBench.sol\":\"StorageBench\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/src/KvStore.sol\":{\"keccak256\":\"0x1cc1a93735b5eec708e704de4927eee30ed3d622961a7befaf1da4c155c667dc\",\"license\":\"PolyForm-Noncommercial-1.0.0\",\"urls\":[\"bzz-raw://94f8b987aaa485a78d60c6e2821090842d80ff97f0cd11e45ba59e9e379a25b4\",\"dweb:/ipfs/QmZg3GipfCzjdxeu5